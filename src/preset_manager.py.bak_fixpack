"""
woldvein Trainer v0.4.6 - 预设方案系统

用户可将当前修改器配置（开启的功能、数值设置等）保存为"预设"，
以后一键加载恢复。

数据结构：
    {
        "name": "我的预设",
        "description": "日常游玩配置",
        "created_at": "2026-09-27 15:00:00",
        "updated_at": "2026-09-27 15:00:00",
        "config": {
            "creative_mode": {...},
            "resources": {...},
            "hotkeys": {...},
            ...
        }
    }

存储位置：程序目录下 presets/ 文件夹，每个预设一个 JSON 文件。
"""
import os
import json
import datetime
import shutil

from .logger import log, log_success, log_error, log_warning
from .atomic_file import atomic_write_json

# 预设目录
def get_presets_dir():
    """获取预设存储目录（程序目录下 presets/）"""
    import sys
    if getattr(sys, "frozen", False):
        base = os.path.dirname(sys.executable)
    else:
        base = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    d = os.path.join(base, "presets")
    os.makedirs(d, exist_ok=True)
    return d


PRESETS_DIR = get_presets_dir()


def _preset_path(name):
    """获取预设文件路径"""
    safe_name = "".join(c for c in name if c.isalnum() or c in "._- ")
    return os.path.join(PRESETS_DIR, f"{safe_name}.json")


def list_presets():
    """列出所有预设，按修改时间倒序。

    返回：
        [{"name": str, "path": str, "modified": str, "size": int}, ...]
    """
    presets = []
    if not os.path.exists(PRESETS_DIR):
        return presets
    for fname in os.listdir(PRESETS_DIR):
        if not fname.endswith(".json"):
            continue
        fpath = os.path.join(PRESETS_DIR, fname)
        try:
            stat = os.stat(fpath)
            presets.append({
                "name": fname[:-5],  # 去掉 .json
                "path": fpath,
                "modified": datetime.datetime.fromtimestamp(stat.st_mtime).strftime("%Y-%m-%d %H:%M:%S"),
                "size": stat.st_size,
            })
        except OSError:
            continue
    presets.sort(key=lambda x: x["modified"], reverse=True)
    return presets


def save_preset(name, config, description=""):
    """保存预设。

    参数：
        name: 预设名称
        config: 配置字典（修改器当前状态）
        description: 预设描述

    返回：
        (success, message)
    """
    if not name or not name.strip():
        return False, "预设名称不能为空"
    name = name.strip()

    now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    preset_data = {
        "name": name,
        "description": description,
        "created_at": now,
        "updated_at": now,
        "config": config,
    }

    # 如果预设已存在，保留 created_at
    existing = load_preset(name)
    if existing and "created_at" in existing:
        preset_data["created_at"] = existing["created_at"]

    try:
        fpath = _preset_path(name)
        atomic_write_json(fpath, preset_data)
        log_success(f"预设已保存: {name}")
        return True, f"预设 '{name}' 已保存"
    except Exception as e:
        log_error(f"保存预设失败: {e}")
        return False, f"保存预设失败: {e}"


def load_preset(name):
    """加载预设。

    返回：
        预设字典，失败返回 None
    """
    fpath = _preset_path(name)
    if not os.path.exists(fpath):
        return None
    try:
        with open(fpath, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception as e:
        log_error(f"加载预设失败: {e}")
        return None


def delete_preset(name):
    """删除预设。

    返回：
        (success, message)
    """
    fpath = _preset_path(name)
    if not os.path.exists(fpath):
        return False, f"预设 '{name}' 不存在"
    try:
        os.remove(fpath)
        log_success(f"预设已删除: {name}")
        return True, f"预设 '{name}' 已删除"
    except Exception as e:
        log_error(f"删除预设失败: {e}")
        return False, f"删除预设失败: {e}"


def rename_preset(old_name, new_name):
    """重命名预设。

    返回：
        (success, message)
    """
    if not new_name or not new_name.strip():
        return False, "新名称不能为空"
    new_name = new_name.strip()

    old_path = _preset_path(old_name)
    new_path = _preset_path(new_name)

    if not os.path.exists(old_path):
        return False, f"预设 '{old_name}' 不存在"
    if os.path.exists(new_path):
        return False, f"预设 '{new_name}' 已存在"

    try:
        # 读取旧预设，更新名称后写入新文件
        preset = load_preset(old_name)
        if preset:
            preset["name"] = new_name
            preset["updated_at"] = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            atomic_write_json(new_path, preset)
            os.remove(old_path)
        else:
            os.rename(old_path, new_path)
        log_success(f"预设已重命名: {old_name} -> {new_name}")
        return True, f"预设已重命名为 '{new_name}'"
    except Exception as e:
        log_error(f"重命名预设失败: {e}")
        return False, f"重命名预设失败: {e}"


def duplicate_preset(name, new_name=None):
    """复制预设。

    返回：
        (success, message, new_name)
    """
    preset = load_preset(name)
    if not preset:
        return False, f"预设 '{name}' 不存在", None

    if not new_name:
        new_name = f"{name}_副本"
        counter = 2
        while os.path.exists(_preset_path(new_name)):
            new_name = f"{name}_副本{counter}"
            counter += 1

    success, msg = save_preset(new_name, preset.get("config", {}), preset.get("description", ""))
    return success, msg, new_name


def export_preset(name, export_path):
    """导出预设到指定路径。

    返回：
        (success, message)
    """
    fpath = _preset_path(name)
    if not os.path.exists(fpath):
        return False, f"预设 '{name}' 不存在"
    try:
        shutil.copy2(fpath, export_path)
        log_success(f"预设已导出: {name} -> {export_path}")
        return True, f"预设已导出到 {export_path}"
    except Exception as e:
        log_error(f"导出预设失败: {e}")
        return False, f"导出预设失败: {e}"


def import_preset(import_path):
    """从外部文件导入预设。

    返回：
        (success, message, preset_name)
    """
    if not os.path.exists(import_path):
        return False, f"文件不存在: {import_path}", None
    try:
        with open(import_path, "r", encoding="utf-8") as f:
            preset = json.load(f)
        name = preset.get("name", os.path.basename(import_path).replace(".json", ""))
        # 处理重名
        original_name = name
        counter = 2
        while os.path.exists(_preset_path(name)):
            name = f"{original_name}_{counter}"
            counter += 1
        success, msg = save_preset(name, preset.get("config", {}), preset.get("description", ""))
        return success, msg, name
    except Exception as e:
        log_error(f"导入预设失败: {e}")
        return False, f"导入预设失败: {e}", None
